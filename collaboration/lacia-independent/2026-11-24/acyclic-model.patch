+def bank_requires_orders(bank, available):
+    """Check whether the union may contain cyclic recipe selections."""
+    dependencies = dict.fromkeys(bank, 0)
+    users = defaultdict(list)
+    for output, recipes in bank.items():
+        operands = {value for _, a, b in recipes for value in (a, b) if value not in available}
+        dependencies[output] = len(operands)
+        for x in operands:
+            users[x].append(output)
+    ready = [v for v, n in dependencies.items() if not n]
+    for value in ready:
+        for user in users.get(value, ()):
+            dependencies[user] -= 1
+            if not dependencies[user]:
+                ready.append(user)
+    return len(ready) != len(bank)
+

+def _required_operand_blocks(groups: dict[int, int], target_count: int):
+    """Compile support masks wholly within one nibble into subset-OR lookups."""
+    fixed = groups.get(0, 0)
+    local = {}
+    cross = []
+    for pattern, inputs in groups.items():
+        if not pattern:
+            continue
+        shift = (((pattern & -pattern).bit_length() - 1) // 4) * 4
+        if pattern.bit_length() > shift + 4:
+            cross.append((pattern, inputs))
+        else:
+            if shift not in local:
+                local[shift] = [0] * (1 << min(4, target_count - shift))
+            local[shift][pattern >> shift] |= inputs
+    blocks = []
+    for shift, table in local.items():
+        for i in range(min(4, target_count - shift)):
+            bit = 1 << i
+            for mask in range(len(table)):
+                if mask & bit:
+                    table[mask] |= table[mask ^ bit]
+        blocks.append((shift, len(table) - 1, tuple(table)))
+    return fixed, tuple(blocks), tuple(cross)
+

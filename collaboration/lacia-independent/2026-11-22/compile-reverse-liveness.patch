+def _chronological_closure(puzzle: Puzzle, proposed: Graph) -> Graph | None:
+    """Extract the original-order live closure, or fall back for a non-topological input."""
+    seeds = set(puzzle.seeds)
+    pending = set(puzzle.targets).difference(seeds)
+    reverse_live = {}
+    for value, recipe in reversed(proposed.items()):
+        if value in pending:
+            pending.remove(value)
+            _, left, right = recipe
+            if left not in seeds:
+                pending.add(left)
+            if right not in seeds:
+                pending.add(right)
+            reverse_live[value] = recipe
+            if not pending:
+                break
+    if pending:
+        return None
+    if len(reverse_live) == len(proposed):
+        return proposed
+    return dict(reversed(reverse_live.items()))
+

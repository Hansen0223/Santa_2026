+class CutPricing:
+    """Price single-goal overrides against exact seed-rooted whole-graph liveness."""
+    def __init__(self,p,graph):
+        self.graph=graph
+        self.puzzle=p
+        self.goals=set(p.targets)-set(p.seeds)
+        self.roots=set(p.seeds)
+        bits={v:1<<i for i,v in enumerate(graph)}
+        self.bits=bits
+        masks=dict.fromkeys(self.roots,0)
+        parents={}
+        for v,(_,a,b) in graph.items():
+            masks[v]=bits[v]|masks[a]|masks[b]
+            parents[v]=bits.get(a,0)|bits.get(b,0)
+        self.masks=masks
+        self.rev=tuple((bits[v],parents[v]) for v in reversed(graph))
+        self.required=sum(bits[v] for v in self.goals)
+        self.cuts={}
+
+    def count(self,target,patch):
+        """Return None when the graph is provably unrooted; allow full fallback."""
+        graph=self.graph
+        masks=self.masks
+        for v in patch:
+            if v!=target and (v in graph or v in self.roots):
+                return len(active_graph(self.puzzle,graph|patch))
+        bit=self.bits[target]
+        kept=self.cuts.get(target)
+        if kept is None:
+            kept=self.required
+            for take,deps in self.rev:
+                if take!=bit and kept&take:kept|=deps
+            self.cuts[target]=kept
+        hot=set()
+        fresh=set()
+        stack=[(target,False)]
+        while stack:
+            v,exit=stack.pop()
+            if exit:
+                hot.remove(v)
+                fresh.add(v)
+            elif v in fresh:
+                continue
+            elif v in hot:
+                return None
+            elif v in patch:
+                hot.add(v)
+                _,a,b=patch[v]
+                stack.extend(((v,True),(b,False),(a,False)))
+            else:
+                legs=masks.get(v)
+                if legs is None or (legs&bit):return None
+                kept|=legs
+        return kept.bit_count()+len(fresh)-1 # cut already pays for the specified goal
+

+class RootedUseIndex:
+    """Index the reverse edges of the currently installed rooted recipes."""
+
+    def __init__(self, recipes):
+        self.users = defaultdict(set)
+        for output, (_, left, right) in recipes.items():
+            self.users[left].add(output)
+            self.users[right].add(output)
+
+    def blocked(self, output):
+        # In a rooted graph the only operands made unavailable by blocking
+        # an output are the output itself and values that depend on it.
+        users = self.users
+        blocked = {output}
+        pending = [output]
+        while pending:
+            for dependent in users.get(pending.pop(), ()):
+                if dependent not in blocked:
+                    blocked.add(dependent)
+                    pending.append(dependent)
+        return blocked
+
+    def changed(self, output, start, winner):
+        users = self.users
+        old_inputs = set(start[1:])
+        new_inputs = set(winner[1:])
+        for operand in old_inputs - new_inputs:
+            users[operand].remove(output)
+        for operand in new_inputs - old_inputs:
+            users[operand].add(output)
+
+
